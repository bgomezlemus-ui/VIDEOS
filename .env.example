# Configuración de Remotion

# Path al ejecutable de Chromium (opcional)
# CHROME_BIN=/usr/bin/chromium

# Número de workers para renderizado en paralelo (default: 2)
# REMOTION_CONCURRENCY=4

# Habilitar logging detallado
# DEBUG=remotion:*

# Bitrate de video (default: auto)
# VIDEO_BITRATE=8000k

# Bitrate de audio (default: 128k)
# AUDIO_BITRATE=128k
